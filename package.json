{
  "name": "dice-room",
  "private": true,
  "version": "1.0.0",
  "description": "Gemeinsamer Würfelraum für Pen&Paper-Runden",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,vite -c magenta,cyan \"wrangler dev --port 8787\" \"vite\"",
    "build": "vite build",
    "preview": "vite build && wrangler dev --port 8787",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.0",
    "@quasar/extras": "^1.17.0",
    "quasar": "^2.18.2",
    "vue": "^3.5.20"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.0",
    "sass": "^1.91.0",
    "vite": "^7.1.3",
    "wrangler": "^4.30.0"
  }
}
